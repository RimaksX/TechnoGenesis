{
  "multipart": [
    {
      "apply": {
        "model": "kontur:block/miner_rail_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "kontur:block/miner_rail_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "kontur:block/miner_rail_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "kontur:block/miner_rail_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "kontur:block/miner_rail_arm",
        "y": 270
      }
    }
  ]
}
